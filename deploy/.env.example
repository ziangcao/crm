CRM_IMAGE=ghcr.io/owner/repository:latest
CRM_DB_PASSWORD=replace-with-a-long-random-hex-value
CRM_BIND_PORT=8000
CRM_COOKIE_SECURE=1
CRM_ALLOWED_ORIGINS=https://crm.example.com
CRM_CONFIG_ENCRYPTION_KEY=replace-with-another-long-random-hex-value
CRM_CUSTOMER_RECYCLE_DAYS=0

# 产品图片存储到独立私有 GitHub 仓库；Token 需仅对该仓库授予 Contents 读写权限。
# CRM_GITHUB_IMAGE_OWNER=ziangcao
# CRM_GITHUB_IMAGE_REPO=crm-product-images
# CRM_GITHUB_IMAGE_BRANCH=main
# CRM_GITHUB_IMAGE_TOKEN=replace-with-fine-grained-token

# 可选：企业微信环境变量。也可以部署后在管理后台配置。
# CRM_WECOM_CORP_ID=ww0000000000000000
# CRM_WECOM_AGENT_ID=1000002
# CRM_WECOM_SECRET=replace-with-wecom-secret
# CRM_WECOM_OAUTH_REDIRECT_URL=https://crm.example.com/api/auth/wecom/callback
